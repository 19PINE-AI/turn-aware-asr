\newlabel{tab:matrix}{{1}{4}{The landscape. ``Cascade'' = VAD + silence timeout + separate ASR: the deployed default, and our measured baseline in Figure~\ref {fig:tradeoff}. Flux and \texttt {semantic\_vad} are the closed members of the turn-aware class this work opens.\relax }{table.caption.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}The phantom frontier}{4}{section.3}\protected@file@percent }
\newlabel{sec:phantom}{{3}{4}{The phantom frontier}{section.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Two ways offline-derived supervision demands clairvoyance.} (a)\nobreakspace  {}Offline clips inherit forced-alignment cuts at the end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph  {hold} --- and the condition ``speech ended, no silence yet'' is one deployment never presents, because silence keeps arriving after a real speaker stops. (b)\nobreakspace  {}Disfluency-vs-boundary pause labels are keyed on who speaks \emph  {next}; at the decision point the prefixes are statistically indistinguishable (the two classes' silence-gap distributions overlap almost completely).\relax }}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:contradictions}{{3}{5}{\textbf {Two ways offline-derived supervision demands clairvoyance.} (a)~Offline clips inherit forced-alignment cuts at the end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph {hold} --- and the condition ``speech ended, no silence yet'' is one deployment never presents, because silence keeps arriving after a real speaker stops. (b)~Disfluency-vs-boundary pause labels are keyed on who speaks \emph {next}; at the decision point the prefixes are statistically indistinguishable (the two classes' silence-gap distributions overlap almost completely).\relax }{figure.caption.7}{}}
\@writefile{toc}{\contentsline {paragraph}{Contradiction 1: the trailing-silence clip cut.}{5}{paragraph*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Contradiction 2: labels keyed on who speaks next.}{5}{paragraph*.9}\protected@file@percent }
