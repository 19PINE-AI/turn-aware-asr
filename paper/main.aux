\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Clairvoyant labels.} Two real pauses, 90\,ms apart in length, from held-out AMI stretches of the replay benchmark (texts and gaps verbatim); the label is decided by the future. At the decision point the prefixes are indistinguishable, so the class is a function of audio after $t$, exactly what a clairvoyant label encodes.\relax }}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:expauses}{{4}{6}{\textbf {Clairvoyant labels.} Two real pauses, 90\,ms apart in length, from held-out AMI stretches of the replay benchmark (texts and gaps verbatim); the label is decided by the future. At the decision point the prefixes are indistinguishable, so the class is a function of audio after $t$, exactly what a clairvoyant label encodes.\relax }{figure.caption.6}{}}
