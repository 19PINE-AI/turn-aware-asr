\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {One failure class, two instances.} Temporal axis (\S  \ref  {sec:diagnosis}): labels that peek at the future manufacture a phantom frontier; the fix is the minimal pair, the same utterance $\pm $ an observable silence tail. Contextual axis (\S  \ref  {sec:second}): a context prefix that always matches the audio becomes a copyable shortcut; the fix is the counterfactual twin, the same audio with a matching and a disagreeing context, target following the audio.\relax }}{14}{figure.caption.25}\protected@file@percent }
\newlabel{fig:twoaxes}{{9}{14}{\textbf {One failure class, two instances.} Temporal axis (\S \ref {sec:diagnosis}): labels that peek at the future manufacture a phantom frontier; the fix is the minimal pair, the same utterance $\pm $ an observable silence tail. Contextual axis (\S \ref {sec:second}): a context prefix that always matches the audio becomes a copyable shortcut; the fix is the counterfactual twin, the same audio with a matching and a disagreeing context, target following the audio.\relax }{figure.caption.25}{}}
