\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Mode circulation, not threshold flapping.} Mean marker-commit probability $P_{\text  {fire}}$ for fire-labeled (complete utterance) and hold-labeled (incomplete) holdout examples across the opposed-pools run; small dots are per-example values. The two classes swing in lockstep as the weights orbit between the fire-mode and no-fire-mode attractors; no example hovers persistently at the 0.5 decision boundary.\relax }}{27}{figure.caption.54}\protected@file@percent }
\newlabel{fig:markerprob}{{11}{27}{\textbf {Mode circulation, not threshold flapping.} Mean marker-commit probability $P_{\text {fire}}$ for fire-labeled (complete utterance) and hold-labeled (incomplete) holdout examples across the opposed-pools run; small dots are per-example values. The two classes swing in lockstep as the weights orbit between the fire-mode and no-fire-mode attractors; no example hovers persistently at the 0.5 decision boundary.\relax }{figure.caption.54}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {The mechanism, isolated.} A ${\sim }30$k-parameter transformer on a synthetic stream with a tunable clairvoyant-label fraction $f$. (a)\nobreakspace  {}Holdout trajectories: monotone convergence at $f{=}0$, visible noise at $f{=}0.7$, bistable mode-oscillation at $f{=}1.0$. (b)\nobreakspace  {}Every checkpoint's (fire recall, hold precision), colored by $f$: the causal run collapses to one top-right point; high $f$ spreads checkpoints into an anti-diagonal cloud, a phantom Pareto frontier traced by one oscillating model.\relax }}{27}{figure.caption.55}\protected@file@percent }
\newlabel{fig:toy}{{12}{27}{\textbf {The mechanism, isolated.} A ${\sim }30$k-parameter transformer on a synthetic stream with a tunable clairvoyant-label fraction $f$. (a)~Holdout trajectories: monotone convergence at $f{=}0$, visible noise at $f{=}0.7$, bistable mode-oscillation at $f{=}1.0$. (b)~Every checkpoint's (fire recall, hold precision), colored by $f$: the causal run collapses to one top-right point; high $f$ spreads checkpoints into an anti-diagonal cloud, a phantom Pareto frontier traced by one oscillating model.\relax }{figure.caption.55}{}}
