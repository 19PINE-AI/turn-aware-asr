\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The causal model escapes the timeout curve.} Median end-of-turn latency vs.\ false fires (log scale; $0^{*}$ plotted at $0.05$) on identical audio, detector, and scoring. A silence timeout can only slide along its curve; the causally supervised model sits strictly inside the whole family because it reads completeness, firing 0.39\,s after a finished thought while holding through a 1.4\,s mid-sentence pause.\relax }}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig:tradeoff}{{2}{2}{\textbf {The causal model escapes the timeout curve.} Median end-of-turn latency vs.\ false fires (log scale; $0^{*}$ plotted at $0.05$) on identical audio, detector, and scoring. A silence timeout can only slide along its curve; the causally supervised model sits strictly inside the whole family because it reads completeness, firing 0.39\,s after a finished thought while holding through a 1.4\,s mid-sentence pause.\relax }{figure.caption.2}{}}
