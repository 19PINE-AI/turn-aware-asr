\@writefile{toc}{\contentsline {paragraph}{Material and ground truth.}{6}{paragraph*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Finding 1: silence incompetence.}{6}{paragraph*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Finding 2: the ranking inverts.}{6}{paragraph*.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Every prior model is silence-incompetent.} Spurious fires of ungated v5 against the silence content of each benchmark stretch: the model hallucinates text and sprays markers on silence at ${\sim }1.9$\,fires/s ($r=0.997$), because every v1--v8 training example begins with speech while a real channel is mostly silence (13 of 22 minutes here). Consequence: \emph  {ungated} recall is uninterpretable --- a random 1.9\,Hz spammer scores 0.96 recall against the tolerance window. The fix costs one line (RMS energy gate), and v9 additionally bakes silence schemas into training.\relax }}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:silence}{{4}{7}{\textbf {Every prior model is silence-incompetent.} Spurious fires of ungated v5 against the silence content of each benchmark stretch: the model hallucinates text and sprays markers on silence at ${\sim }1.9$\,fires/s ($r=0.997$), because every v1--v8 training example begins with speech while a real channel is mostly silence (13 of 22 minutes here). Consequence: \emph {ungated} recall is uninterpretable --- a random 1.9\,Hz spammer scores 0.96 recall against the tolerance window. The fix costs one line (RMS energy gate), and v9 additionally bakes silence schemas into training.\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {The ranking inversion.} Left: the legacy offline benchmark (fire-rate on clips cut at end-of-speech). Right: the deployment-matched replay benchmark (false fires per speech-minute, energy gate on; full metrics in Table\nobreakspace  {}\ref  {tab:main}). The offline champion v3 fires 89 times per speech-minute mid-utterance --- its offline strength \emph  {is} a premature-fire pathology once audio keeps flowing. v8, written off at 10\% offline, is the best prior endpointer. Both historical ship decisions were wrong.\relax }}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:inversion}{{5}{7}{\textbf {The ranking inversion.} Left: the legacy offline benchmark (fire-rate on clips cut at end-of-speech). Right: the deployment-matched replay benchmark (false fires per speech-minute, energy gate on; full metrics in Table~\ref {tab:main}). The offline champion v3 fires 89 times per speech-minute mid-utterance --- its offline strength \emph {is} a premature-fire pathology once audio keeps flowing. v8, written off at 10\% offline, is the best prior endpointer. Both historical ship decisions were wrong.\relax }{figure.caption.13}{}}
