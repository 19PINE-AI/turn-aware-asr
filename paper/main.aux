\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The minimal-pair device.} Each complete utterance appears twice in the training data: without a silence tail (target: transcript only) and with a 0.3--1.2\,s tail (target: transcript + marker). The only difference between the opposite-labeled examples is the observable the model must key on. This construction is what removes the training pathology of Figure\nobreakspace  {}\ref  {fig:oscillation}.\relax }}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:minimalpair}{{4}{7}{\textbf {The minimal-pair device.} Each complete utterance appears twice in the training data: without a silence tail (target: transcript only) and with a 0.3--1.2\,s tail (target: transcript + marker). The only difference between the opposite-labeled examples is the observable the model must key on. This construction is what removes the training pathology of Figure~\ref {fig:oscillation}.\relax }{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces The landscape (verified July 2026; details in \S  \ref  {sec:related}). ``Turn detectors'' = Smart Turn (acoustic), LiveKit and TEN (text/audio EOU): separate models beside a recognizer. ``Cascade'' = VAD + silence timeout + separate ASR, the deployed default and our measured baseline in Figure\nobreakspace  {}\ref  {fig:tradeoff}. Kyutai STT's semantic-VAD head and Parakeet's \texttt  {<EOU>} token are open-weights capabilities without published training accounts; Smart Turn is the one fully open recipe, but it does not transcribe.\relax }}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:matrix}{{1}{7}{The landscape (verified July 2026; details in \S \ref {sec:related}). ``Turn detectors'' = Smart Turn (acoustic), LiveKit and TEN (text/audio EOU): separate models beside a recognizer. ``Cascade'' = VAD + silence timeout + separate ASR, the deployed default and our measured baseline in Figure~\ref {fig:tradeoff}. Kyutai STT's semantic-VAD head and Parakeet's \texttt {<EOU>} token are open-weights capabilities without published training accounts; Smart Turn is the one fully open recipe, but it does not transcribe.\relax }{table.caption.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}The training recipe: one causal rule}{7}{section.4}\protected@file@percent }
\newlabel{sec:recipe}{{4}{7}{The training recipe: one causal rule}{section.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The eight training schemas (${\sim }12$k examples; LibriSpeech and AMI roughly 50/50). $M$ = \texttt  {<EAGER\_END\_SPEECH>}\texttt  {<END\_SPEECH>}. Schemas 1--2 are the minimal-pair device (Figure\nobreakspace  {}\ref  {fig:minimalpair}); 4--5 teach pause discrimination from the \emph  {prefix} (hold only when the words so far are incomplete); 7--8 cover the silence-heavy channel shape that pure-utterance corpora never show (\S  \ref  {sec:eval}).\relax }}{8}{table.caption.10}\protected@file@percent }
\newlabel{tab:schemas}{{2}{8}{The eight training schemas (${\sim }12$k examples; LibriSpeech and AMI roughly 50/50). $M$ = \eager \fire . Schemas 1--2 are the minimal-pair device (Figure~\ref {fig:minimalpair}); 4--5 teach pause discrimination from the \emph {prefix} (hold only when the words so far are incomplete); 7--8 cover the silence-heavy channel shape that pure-utterance corpora never show (\S \ref {sec:eval}).\relax }{table.caption.10}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}What went wrong eight times: clairvoyant labels}{8}{section.5}\protected@file@percent }
\newlabel{sec:phantom}{{5}{8}{What went wrong eight times: clairvoyant labels}{section.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {The fingerprint of contradictory supervision.} Left: under the opposed-pools recipe (clairvoyant labels), holdout accuracy oscillates for the entire run between a \emph  {fire-mode} attractor (fire class ${\approx }1.0$, hold class ${\approx }0.4$) and a \emph  {no-fire-mode} attractor (fire ${\approx }0.1$, hold ${\approx }1.0$): the pools assign opposite targets to causally identical audio, so no single policy satisfies both. Right: the causal recipe of \S  \ref  {sec:recipe} --- same architecture, same LoRA recipe, same data volume, \emph  {only the labels changed} --- climbs monotonically, and both classes sit at ceiling \emph  {simultaneously} from step 3k on.\relax }}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:oscillation}{{5}{9}{\textbf {The fingerprint of contradictory supervision.} Left: under the opposed-pools recipe (clairvoyant labels), holdout accuracy oscillates for the entire run between a \emph {fire-mode} attractor (fire class ${\approx }1.0$, hold class ${\approx }0.4$) and a \emph {no-fire-mode} attractor (fire ${\approx }0.1$, hold ${\approx }1.0$): the pools assign opposite targets to causally identical audio, so no single policy satisfies both. Right: the causal recipe of \S \ref {sec:recipe} --- same architecture, same LoRA recipe, same data volume, \emph {only the labels changed} --- climbs monotonically, and both classes sit at ceiling \emph {simultaneously} from step 3k on.\relax }{figure.caption.11}{}}
\@writefile{toc}{\contentsline {paragraph}{Mechanism 1: the trailing-silence clip cut.}{9}{paragraph*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Mechanism 2: labels keyed on who speaks next.}{9}{paragraph*.14}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The record, and the intervention that falsified the frontier.}{9}{paragraph*.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Two ways offline-derived supervision demands clairvoyance.} (a)\nobreakspace  {}Offline clips inherit forced-alignment cuts at the end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph  {hold} --- and the condition ``speech ended, no silence yet'' is one deployment never presents, because silence keeps arriving after a real speaker stops. (b)\nobreakspace  {}Disfluency-vs-boundary pause labels are keyed on who speaks \emph  {next}; at the decision point the prefixes are statistically indistinguishable (the two classes' silence-gap distributions overlap almost completely).\relax }}{10}{figure.caption.12}\protected@file@percent }
\newlabel{fig:contradictions}{{6}{10}{\textbf {Two ways offline-derived supervision demands clairvoyance.} (a)~Offline clips inherit forced-alignment cuts at the end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph {hold} --- and the condition ``speech ended, no silence yet'' is one deployment never presents, because silence keeps arriving after a real speaker stops. (b)~Disfluency-vs-boundary pause labels are keyed on who speaks \emph {next}; at the decision point the prefixes are statistically indistinguishable (the two classes' silence-gap distributions overlap almost completely).\relax }{figure.caption.12}{}}
