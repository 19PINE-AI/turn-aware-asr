\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {The supervision-composition record.} Eight recipes, one architecture; each row adds one labeled pool (cumulative). ``Early'' latencies are negative: the model fires seconds before the turn actually ends. The trade-off pattern --- every fix moves along the frontier, never off it --- is the second fingerprint of contradictory supervision.\relax }}{7}{table.caption.12}\protected@file@percent }
\newlabel{tab:composition}{{2}{7}{\textbf {The supervision-composition record.} Eight recipes, one architecture; each row adds one labeled pool (cumulative). ``Early'' latencies are negative: the model fires seconds before the turn actually ends. The trade-off pattern --- every fix moves along the frontier, never off it --- is the second fingerprint of contradictory supervision.\relax }{table.caption.12}{}}
\@writefile{toc}{\contentsline {paragraph}{Labels keyed on who speaks next (Mechanism B).}{7}{paragraph*.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Two ways offline-derived supervision demands clairvoyance.} (a)\nobreakspace  {}Offline clips inherit forced-alignment cuts at the end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph  {hold} --- and the condition ``speech ended, no silence yet'' is one deployment never presents, because silence keeps arriving after a real speaker stops. (b)\nobreakspace  {}Disfluency-vs-boundary pause labels are keyed on who speaks \emph  {next}; at the decision point the prefixes are statistically indistinguishable (the two classes' silence-gap distributions overlap almost completely).\relax }}{8}{figure.caption.13}\protected@file@percent }
\newlabel{fig:contradictions}{{3}{8}{\textbf {Two ways offline-derived supervision demands clairvoyance.} (a)~Offline clips inherit forced-alignment cuts at the end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph {hold} --- and the condition ``speech ended, no silence yet'' is one deployment never presents, because silence keeps arriving after a real speaker stops. (b)~Disfluency-vs-boundary pause labels are keyed on who speaks \emph {next}; at the decision point the prefixes are statistically indistinguishable (the two classes' silence-gap distributions overlap almost completely).\relax }{figure.caption.13}{}}
