\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {One failure class, two instances.} Temporal axis (\S  \ref  {sec:recipe}, \S  \ref  {sec:analysis}): labels that peek at the future manufacture a phantom frontier; the fix is the minimal pair, the same utterance $\pm $ an observable silence tail. Contextual axis (\S  \ref  {sec:ctxrecipe}): a context prefix that always matches the audio becomes a copyable shortcut; the fix is the counterfactual twin, the same audio with a matching and a disagreeing context, target following the audio.\relax }}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:twoaxes}{{4}{6}{\textbf {One failure class, two instances.} Temporal axis (\S \ref {sec:recipe}, \S \ref {sec:analysis}): labels that peek at the future manufacture a phantom frontier; the fix is the minimal pair, the same utterance $\pm $ an observable silence tail. Contextual axis (\S \ref {sec:ctxrecipe}): a context prefix that always matches the audio becomes a copyable shortcut; the fix is the counterfactual twin, the same audio with a matching and a disagreeing context, target following the audio.\relax }{figure.caption.6}{}}
