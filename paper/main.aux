\@writefile{toc}{\contentsline {paragraph}{The two leaks, illustrated.}{25}{paragraph*.51}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Two ways offline-derived supervision leaks the future.} (a)\nobreakspace  {}Offline clips inherit forced-alignment cuts at end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph  {hold}. (b)\nobreakspace  {}Disfluency-vs-boundary pause labels are keyed on who speaks next; at the decision point the two classes' silence-gap distributions overlap almost completely.\relax }}{26}{figure.caption.52}\protected@file@percent }
\newlabel{fig:contradictions}{{10}{26}{\textbf {Two ways offline-derived supervision leaks the future.} (a)~Offline clips inherit forced-alignment cuts at end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph {hold}. (b)~Disfluency-vs-boundary pause labels are keyed on who speaks next; at the decision point the two classes' silence-gap distributions overlap almost completely.\relax }{figure.caption.52}{}}
