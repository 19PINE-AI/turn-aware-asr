\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {The minimal-pair device.} Each complete utterance appears twice in v9's training data: without a silence tail (target: transcript only) and with a 0.3--1.2\,s tail (target: transcript + marker). The only difference between the opposite-labeled examples is the observable the model must use. This construction is what removes the oscillation in Figure\nobreakspace  {}\ref  {fig:oscillation}.\relax }}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:minimalpair}{{6}{8}{\textbf {The minimal-pair device.} Each complete utterance appears twice in v9's training data: without a silence tail (target: transcript only) and with a 0.3--1.2\,s tail (target: transcript + marker). The only difference between the opposite-labeled examples is the observable the model must use. This construction is what removes the oscillation in Figure~\ref {fig:oscillation}.\relax }{figure.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Main result} (deployment-matched replay, energy gate on; latency-vs-false-fire view in Figure\nobreakspace  {}\ref  {fig:tradeoff}). Rows 1--4: the 25-stretch development benchmark (96 turn-final boundaries). v9 dominates every predecessor without either crutch: its \emph  {raw} false-fire rate beats v5's \emph  {confirmed} rate, and its WER needs no force-flush. The confirm ablation: v5's horizon cancels 241 phrase-boundary candidates; v9's cancels 3. Last row: a \emph  {fresh} $2\times $-larger stretch set (seed changed, 50 stretches, 184 boundaries) drawn after all development ended --- latency and false fires hold; recall dips 4.5\,pp (\S  \ref  {sec:limits}). $^{\dagger }$WER mean dominated by long-monologue repetition loops when no force-flush bounds the segment (v9 fresh-set WER \emph  {median} 0.30, matching the development set; the \S  \ref  {sec:serving} force-flush bounds this tail).\relax }}{8}{table.caption.17}\protected@file@percent }
\newlabel{tab:main}{{2}{8}{\textbf {Main result} (deployment-matched replay, energy gate on; latency-vs-false-fire view in Figure~\ref {fig:tradeoff}). Rows 1--4: the 25-stretch development benchmark (96 turn-final boundaries). v9 dominates every predecessor without either crutch: its \emph {raw} false-fire rate beats v5's \emph {confirmed} rate, and its WER needs no force-flush. The confirm ablation: v5's horizon cancels 241 phrase-boundary candidates; v9's cancels 3. Last row: a \emph {fresh} $2\times $-larger stretch set (seed changed, 50 stretches, 184 boundaries) drawn after all development ended --- latency and false fires hold; recall dips 4.5\,pp (\S \ref {sec:limits}). $^{\dagger }$WER mean dominated by long-monologue repetition loops when no force-flush bounds the segment (v9 fresh-set WER \emph {median} 0.30, matching the development set; the \S \ref {sec:serving} force-flush bounds this tail).\relax }{table.caption.17}{}}
\@writefile{toc}{\contentsline {paragraph}{The fingerprint, removed.}{8}{paragraph*.16}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Dominance.}{8}{paragraph*.19}\protected@file@percent }
\citation{delrio2022earnings22}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Semantic endpointing escapes the timeout curve.} Median latency vs false fires (log scale; $0^{*}$ = zero plotted at $0.05$) on identical stretches, detector, and scoring. A silence timeout $X$ can only slide along its curve: matching v9's recall takes $X{=}1.0$\,s --- $3\times $ the latency, ${\sim }5\times $ the false fires; the fastest usable setting ($X{=}0.5$\,s) produces $21\times $ the false fires; $X{\geq }1.5$\,s leaves the recall tolerance window entirely (open markers) --- the assistant that waits too long. The Silero cascade \citep  {silero2021vad} is dominated by plain RMS on this close-talk channel. v9 sits strictly inside the whole family because it reads \emph  {completeness}: it fires 0.39\,s after a finished thought and holds through a 1.4\,s mid-sentence pause. Honest caveat: v9 segments quick resumes at the same rate as an aggressive timeout (resume-after-fire 1.0, by design --- the correct choice is unknowable at decision time); deployments preferring merged segments pay $+0.5$\,s via confirm1.\relax }}{9}{figure.caption.18}\protected@file@percent }
\newlabel{fig:tradeoff}{{7}{9}{\textbf {Semantic endpointing escapes the timeout curve.} Median latency vs false fires (log scale; $0^{*}$ = zero plotted at $0.05$) on identical stretches, detector, and scoring. A silence timeout $X$ can only slide along its curve: matching v9's recall takes $X{=}1.0$\,s --- $3\times $ the latency, ${\sim }5\times $ the false fires; the fastest usable setting ($X{=}0.5$\,s) produces $21\times $ the false fires; $X{\geq }1.5$\,s leaves the recall tolerance window entirely (open markers) --- the assistant that waits too long. The Silero cascade \citep {silero2021vad} is dominated by plain RMS on this close-talk channel. v9 sits strictly inside the whole family because it reads \emph {completeness}: it fires 0.39\,s after a finished thought and holds through a 1.4\,s mid-sentence pause. Honest caveat: v9 segments quick resumes at the same rate as an aggressive timeout (resume-after-fire 1.0, by design --- the correct choice is unknowable at decision time); deployments preferring merged segments pay $+0.5$\,s via confirm1.\relax }{figure.caption.18}{}}
