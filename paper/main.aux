\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}The mechanism, isolated}{15}{subsection.6.3}\protected@file@percent }
\newlabel{sec:toy}{{6.3}{15}{The mechanism, isolated}{subsection.6.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Two ways offline-derived supervision leaks the future.} (a)\nobreakspace  {}Offline clips inherit forced-alignment cuts at end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph  {hold}. (b)\nobreakspace  {}Disfluency-vs-boundary pause labels are keyed on who speaks next; at the decision point the two classes' silence-gap distributions overlap almost completely.\relax }}{16}{figure.caption.25}\protected@file@percent }
\newlabel{fig:contradictions}{{7}{16}{\textbf {Two ways offline-derived supervision leaks the future.} (a)~Offline clips inherit forced-alignment cuts at end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph {hold}. (b)~Disfluency-vs-boundary pause labels are keyed on who speaks next; at the decision point the two classes' silence-gap distributions overlap almost completely.\relax }{figure.caption.25}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Evaluation is where the leak enters}{16}{subsection.6.4}\protected@file@percent }
\newlabel{sec:inversion}{{6.4}{16}{Evaluation is where the leak enters}{subsection.6.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {The mechanism, isolated.} A ${\sim }30$k-parameter transformer on a synthetic stream with a tunable clairvoyant-label fraction $f$. (a)\nobreakspace  {}Holdout trajectories: monotone convergence at $f{=}0$, visible noise at $f{=}0.7$, bistable mode-oscillation at $f{=}1.0$. (b)\nobreakspace  {}Every checkpoint's (fire recall, hold precision), colored by $f$: the causal run collapses to one top-right point; high $f$ spreads checkpoints into an anti-diagonal cloud --- a phantom Pareto frontier traced by one oscillating model.\relax }}{17}{figure.caption.27}\protected@file@percent }
\newlabel{fig:toy}{{8}{17}{\textbf {The mechanism, isolated.} A ${\sim }30$k-parameter transformer on a synthetic stream with a tunable clairvoyant-label fraction $f$. (a)~Holdout trajectories: monotone convergence at $f{=}0$, visible noise at $f{=}0.7$, bistable mode-oscillation at $f{=}1.0$. (b)~Every checkpoint's (fire recall, hold precision), colored by $f$: the causal run collapses to one top-right point; high $f$ spreads checkpoints into an anti-diagonal cloud --- a phantom Pareto frontier traced by one oscillating model.\relax }{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {The ranking inversion.} Model ranking on the legacy offline benchmark (left) versus the deployment-matched replay benchmark (right). The offline champion is the worst live model.\relax }}{17}{figure.caption.28}\protected@file@percent }
\newlabel{fig:inversion}{{9}{17}{\textbf {The ranking inversion.} Model ranking on the legacy offline benchmark (left) versus the deployment-matched replay benchmark (right). The offline champion is the worst live model.\relax }{figure.caption.28}{}}
