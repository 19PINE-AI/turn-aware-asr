\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The fingerprint of contradictory supervision.} Left: under the opposed-pools recipe, holdout accuracy oscillates for the entire run between a fire-mode and a no-fire-mode attractor. Right: the causal recipe of \S  \ref  {sec:fix} --- same architecture, adapter, and data volume, only the labels changed --- climbs monotonically, with both classes at ceiling simultaneously from step 3k on.\relax }}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:oscillation}{{3}{7}{\textbf {The fingerprint of contradictory supervision.} Left: under the opposed-pools recipe, holdout accuracy oscillates for the entire run between a fire-mode and a no-fire-mode attractor. Right: the causal recipe of \S \ref {sec:fix} --- same architecture, adapter, and data volume, only the labels changed --- climbs monotonically, with both classes at ceiling simultaneously from step 3k on.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {paragraph}{The diagnosis.}{7}{paragraph*.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Two ways offline-derived supervision leaks the future.} (a)\nobreakspace  {}Offline clips inherit forced-alignment cuts at end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph  {hold}. (b)\nobreakspace  {}Disfluency-vs-boundary pause labels are keyed on who speaks next; at the decision point the two classes' silence-gap distributions overlap almost completely.\relax }}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:contradictions}{{4}{8}{\textbf {Two ways offline-derived supervision leaks the future.} (a)~Offline clips inherit forced-alignment cuts at end of speech, so the offline pool demands a fire on exactly the prefix the streaming pool labels \emph {hold}. (b)~Disfluency-vs-boundary pause labels are keyed on who speaks next; at the decision point the two classes' silence-gap distributions overlap almost completely.\relax }{figure.caption.10}{}}
