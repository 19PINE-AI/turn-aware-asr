\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces The eight training schemas (${\sim }12$k examples; LibriSpeech and AMI roughly 50/50). $M$ = \texttt  {<EAGER\_END\_SPEECH>}\texttt  {<END\_SPEECH>}.\relax }}{7}{table.caption.8}\protected@file@percent }
