\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Semantic endpointing escapes the timeout curve.} Median end-of-turn latency vs false fires (log scale; $0^{*}$ = zero plotted at $0.05$) on identical audio, detector, and scoring (\S  \ref  {sec:eval}). A silence timeout $X$ can only slide along its curve: matching our model's recall takes $X{=}1.0$\,s --- $3\times $ the latency, ${\sim }5\times $ the false fires; the fastest usable setting ($X{=}0.5$\,s) produces $21\times $ the false fires; $X{\geq }1.5$\,s leaves the recall tolerance window entirely (open markers) --- the assistant that waits too long. The Silero cascade \citep  {silero2021vad} is dominated by plain RMS on this close-talk channel. The causally-supervised model (\S  \ref  {sec:recipe}) sits strictly inside the whole family because it reads \emph  {completeness}: it fires 0.39\,s after a finished thought and holds through a 1.4\,s mid-sentence pause.\relax }}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:tradeoff}{{1}{3}{\textbf {Semantic endpointing escapes the timeout curve.} Median end-of-turn latency vs false fires (log scale; $0^{*}$ = zero plotted at $0.05$) on identical audio, detector, and scoring (\S \ref {sec:eval}). A silence timeout $X$ can only slide along its curve: matching our model's recall takes $X{=}1.0$\,s --- $3\times $ the latency, ${\sim }5\times $ the false fires; the fastest usable setting ($X{=}0.5$\,s) produces $21\times $ the false fires; $X{\geq }1.5$\,s leaves the recall tolerance window entirely (open markers) --- the assistant that waits too long. The Silero cascade \citep {silero2021vad} is dominated by plain RMS on this close-talk channel. The causally-supervised model (\S \ref {sec:recipe}) sits strictly inside the whole family because it reads \emph {completeness}: it fires 0.39\,s after a finished thought and holds through a 1.4\,s mid-sentence pause.\relax }{figure.caption.1}{}}
\@writefile{toc}{\contentsline {paragraph}{One principle, two axes.}{3}{paragraph*.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {One principle, two axes.} A streaming model acts on its causal prefix, so its training target must depend only on that prefix. \emph  {Temporal axis} (\S  \ref  {sec:phantom}): offline labels that peek at the future (clip cut at end-of-speech; pause labeled by who speaks next) are clairvoyant and manufacture a phantom recall-vs-precision frontier; the fix is a minimal pair --- the same utterance $\pm $ an observable silence tail. \emph  {Contextual axis} (\S  \ref  {sec:dictation}): a context prefix that always matches the audio in training becomes a copyable shortcut, so a wrong profile is transcribed verbatim; the fix is the counterfactual twin --- the same audio with a matching and a disagreeing context, target following the audio. Same disease (the target depends on an untrustworthy signal), same cure (make that signal uninformative by construction).\relax }}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:twoaxes}{{2}{4}{\textbf {One principle, two axes.} A streaming model acts on its causal prefix, so its training target must depend only on that prefix. \emph {Temporal axis} (\S \ref {sec:phantom}): offline labels that peek at the future (clip cut at end-of-speech; pause labeled by who speaks next) are clairvoyant and manufacture a phantom recall-vs-precision frontier; the fix is a minimal pair --- the same utterance $\pm $ an observable silence tail. \emph {Contextual axis} (\S \ref {sec:dictation}): a context prefix that always matches the audio in training becomes a copyable shortcut, so a wrong profile is transcribed verbatim; the fix is the counterfactual twin --- the same audio with a matching and a disagreeing context, target following the audio. Same disease (the target depends on an untrustworthy signal), same cure (make that signal uninformative by construction).\relax }{figure.caption.3}{}}
