\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {The mechanism, isolated.} A ${\sim }30$k-parameter transformer on a synthetic stream with a tunable clairvoyant-label fraction $f$. (a)\nobreakspace  {}Holdout trajectories: monotone convergence at $f{=}0$, visible noise at $f{=}0.7$, oscillation between two modes at $f{=}1.0$. (b)\nobreakspace  {}Every checkpoint's (fire recall, hold precision), colored by $f$: the causal run collapses to one top-right point; high $f$ spreads checkpoints into an anti-diagonal cloud, a phantom Pareto frontier traced by one oscillating model.\relax }}{29}{figure.caption.60}\protected@file@percent }
\newlabel{fig:toy}{{16}{29}{\textbf {The mechanism, isolated.} A ${\sim }30$k-parameter transformer on a synthetic stream with a tunable clairvoyant-label fraction $f$. (a)~Holdout trajectories: monotone convergence at $f{=}0$, visible noise at $f{=}0.7$, oscillation between two modes at $f{=}1.0$. (b)~Every checkpoint's (fire recall, hold precision), colored by $f$: the causal run collapses to one top-right point; high $f$ spreads checkpoints into an anti-diagonal cloud, a phantom Pareto frontier traced by one oscillating model.\relax }{figure.caption.60}{}}
